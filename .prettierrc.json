{
  "printWidth": 120,
  "tabWidth": 4,
  "singleQuote": true,
  "semi": true,
  "plugins": ["prettier-plugin-blade", "prettier-plugin-tailwindcss"],
  "overrides": [
    { "files": ["*.blade.php"], "options": { "parser": "blade" } },
    { "files": ["*.{yml,yaml,json}"], "options": { "tabWidth": 2 } }
  ]
}
