{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "bezvahania/web",
  "type": "project",
  "description": "Web a rezervačný systém pre domáce workshopy prvej pomoci bezvahania.sk.",
  "keywords": [
    "laravel",
    "filament",
    "first-aid"
  ],
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "filament/filament": "^5.12",
    "laravel/framework": "^13.17",
    "laravel/tinker": "^3.0",
    "spatie/laravel-translatable": "^6.15"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "larastan/larastan": "^3.15",
    "laravel-lang/common": "^6.9",
    "laravel/boost": "^2.10",
    "laravel/pail": "^1.2.5",
    "laravel/pao": "^1.0.6",
    "laravel/pint": "^1.27",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "pestphp/pest": "^5.3",
    "pestphp/pest-plugin-browser": "^5.2",
    "pestphp/pest-plugin-laravel": "^5.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": [
      "vendor/bin/pint --test",
      "npx prettier --check ."
    ],
    "format": [
      "vendor/bin/pint",
      "npx prettier --write ."
    ],
    "analyse": [
      "vendor/bin/phpstan analyse --memory-limit=1G --no-progress"
    ],
    "test": [
      "@php artisan config:clear --ansi",
      "vendor/bin/pest --testsuite=Unit,Feature --parallel --processes=4 --coverage --min=80"
    ],
    "test:browser": [
      "@php artisan config:clear --ansi",
      "@php artisan view:cache --ansi",
      "vendor/bin/pest --testsuite=Browser"
    ],
    "docs:check": [
      "@php scripts/docs-check.php"
    ],
    "check": [
      "Composer\\Config::disableProcessTimeout",
      "bash scripts/check.sh"
    ],
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi",
      "@php artisan filament:upgrade"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
      "@php artisan migrate --graceful --ansi"
    ],
    "pre-package-uninstall": [
      "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    },
    "platform": {
      "php": "8.4.28"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts-descriptions": {
    "lint": "Pint --test + Prettier --check",
    "format": "Pint + Prettier (zapíše zmeny)",
    "analyse": "Larastan (PHPStan)",
    "test": "Unit + Feature, paralelne, coverage min. 80 %",
    "test:browser": "Pest browser testy (Playwright)",
    "docs:check": "Kontrola dokumentácie",
    "check": "Všetky brány kvality + build, zapíše .check-passed"
  }
}
