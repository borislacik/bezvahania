# Lokálne vývojové prostredie (Docker). Produkčný .env existuje iba na serveri (shared/.env).
# Popis premenných: README.md, sekcia „Premenné prostredia“.

APP_NAME="Bez váhania"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Bratislava

# Dve domény, jedna aplikácia (docs/adr/0003-two-domains-one-app.md)
APP_DOMAIN=bezvahania.localhost
ADMIN_DOMAIN=admin.bezvahania.localhost
ADMIN_URL=http://admin.bezvahania.localhost
APP_URL=http://bezvahania.localhost

# Admin: povinné dvojfaktorové overenie (TOTP). Na produkcii vždy true, lokálne môže byť false.
ADMIN_MFA_REQUIRED=false

APP_LOCALE=sk
APP_FALLBACK_LOCALE=sk
APP_FAKER_LOCALE=sk_SK

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Chyby sa iba logujú, žiadne e-maily (rozhodnutie z 23. 11. 2026)
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MariaDB v Dockeri (služba "db" v compose.yaml)
DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=bezvahania
DB_USERNAME=bezvahania
DB_PASSWORD=secret

# Zdieľaný hosting: fronta, cache aj session cez databázu (bez Redisu)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mailpit v Dockeri, UI na http://localhost:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="rezervacie@bezvahania.sk"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Google Analytics 4 (načíta sa iba po súhlase v cookie lište).
# Lokálne prázdne, aby vývoj neposielal dáta. Produkcia: G-Z690RSSEM0
GOOGLE_ANALYTICS_ID=

# Porty na Windows hoste (compose.yaml)
APP_PORT=80
VITE_PORT=5173
FORWARD_DB_PORT=3306
FORWARD_MAILPIT_UI_PORT=8025
